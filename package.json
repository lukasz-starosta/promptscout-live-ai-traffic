{
  "name": "promptscout-live-ai-traffic",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for PromptScout live AI traffic packages, provider integrations, examples, and docs.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "verify": "./scripts/verify",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "typescript": "5.8.3"
  }
}
