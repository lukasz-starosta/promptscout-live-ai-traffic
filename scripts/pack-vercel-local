#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: ./scripts/pack-vercel-local [--dry-run]

Build and pack the local Vercel/Next.js middleware package and its core
dependency for PromptScout dogfooding without publishing to npm.

Environment:
  PROMPTSCOUT_LOCAL_PACK_DIR  Output directory. Defaults to .promptscout-local-packages.
USAGE
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

DRY_RUN=0
if [[ "${1:-}" == "--dry-run" ]]; then
  DRY_RUN=1
  shift
fi

if [[ $# -gt 0 ]]; then
  usage >&2
  exit 2
fi

if ! command -v git >/dev/null 2>&1; then
  echo "git is required to locate the repository root" >&2
  exit 127
fi

if ! ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "scripts/pack-vercel-local must be run inside a git checkout" >&2
  exit 1
fi

cd "$ROOT"

if ! command -v node >/dev/null 2>&1; then
  echo "node is required to read the package version" >&2
  exit 127
fi

VERSION="$(node -p "require('./package.json').version")"
ARTIFACT_DIR="${PROMPTSCOUT_LOCAL_PACK_DIR:-$ROOT/.promptscout-local-packages}"
ARTIFACT_DIR="$(node -e 'console.log(require("node:path").resolve(process.argv[1]))' "$ARTIFACT_DIR")"
CORE_TARBALL="$ARTIFACT_DIR/promptscout-live-ai-traffic-core-v$VERSION.tgz"
MIDDLEWARE_TARBALL="$ARTIFACT_DIR/promptscout-live-ai-traffic-vercel-middleware-v$VERSION.tgz"

display_path() {
  local path="$1"

  case "$path" in
    "$ROOT"/*) printf '%s' "${path#"$ROOT"/}" ;;
    *) printf '%s' "$path" ;;
  esac
}

print_promptscout_install() {
  local core_path middleware_path

  core_path="file:$CORE_TARBALL"
  middleware_path="file:$MIDDLEWARE_TARBALL"

  cat <<EOF
PromptScout checkout command:
yarn add @lukasz-starosta/promptscout-live-ai-traffic-core@$core_path @lukasz-starosta/promptscout-live-ai-traffic-vercel-middleware@$middleware_path

PromptScout package.json dependency entries:
"@lukasz-starosta/promptscout-live-ai-traffic-core": "$core_path"
"@lukasz-starosta/promptscout-live-ai-traffic-vercel-middleware": "$middleware_path"

No npm publish is required.
EOF
}

rewrite_middleware_core_dependency() {
  local temp_dir

  temp_dir="$(mktemp -d)"
  (
    trap 'rm -rf "$temp_dir"' EXIT

    tar -xzf "$MIDDLEWARE_TARBALL" -C "$temp_dir"
    node --input-type=module - "$temp_dir/package/package.json" "$CORE_TARBALL" <<'NODE'
import { readFileSync, writeFileSync } from "node:fs";

const [packageJsonPath, coreTarballPath] = process.argv.slice(2);
const packageJson = JSON.parse(readFileSync(packageJsonPath, "utf8"));

packageJson.dependencies ??= {};
packageJson.dependencies["@lukasz-starosta/promptscout-live-ai-traffic-core"] = `file:${coreTarballPath}`;

writeFileSync(packageJsonPath, `${JSON.stringify(packageJson, null, 2)}\n`);
NODE
    (
      cd "$temp_dir"
      tar -czf "$MIDDLEWARE_TARBALL" package
    )
  )
}

if [[ "$DRY_RUN" -eq 1 ]]; then
  cat <<EOF
yarn tsc -b packages/core packages/vercel-middleware
yarn workspace @lukasz-starosta/promptscout-live-ai-traffic-core pack --out $(display_path "$CORE_TARBALL")
yarn workspace @lukasz-starosta/promptscout-live-ai-traffic-vercel-middleware pack --out $(display_path "$MIDDLEWARE_TARBALL")
EOF
  print_promptscout_install
  exit 0
fi

mkdir -p "$ARTIFACT_DIR"

yarn tsc -b packages/core packages/vercel-middleware
yarn workspace @lukasz-starosta/promptscout-live-ai-traffic-core pack --out "$CORE_TARBALL"
yarn workspace @lukasz-starosta/promptscout-live-ai-traffic-vercel-middleware pack --out "$MIDDLEWARE_TARBALL"
rewrite_middleware_core_dependency

cat <<EOF
Created local PromptScout dogfood artifacts:
- $(display_path "$CORE_TARBALL")
- $(display_path "$MIDDLEWARE_TARBALL")

EOF
print_promptscout_install
