{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@promptscout/live-ai-traffic": ["packages/core/src/index.ts"],
      "@promptscout/live-ai-traffic/core": ["packages/core/src/index.ts"],
      "@promptscout/live-ai-traffic/vercel-middleware": [
        "packages/vercel-middleware/src/index.ts"
      ],
      "@promptscout/live-ai-traffic/cloudflare-worker": [
        "packages/cloudflare-worker/src/index.ts"
      ],
      "promptscout-live-ai-traffic-*": ["packages/*/src/index.ts"]
    }
  }
}
